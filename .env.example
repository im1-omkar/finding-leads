# Local Docker Compose configuration. Copy this file to .env before starting.
# Never commit real credentials; enter deployed secrets in the Render/Vercel dashboards.

APP_ENV=development
APP_SESSION_SECRET=development-only-change-me
RESEARCH_ENABLED=true
MOCK_MODE=true
NUMBER_OF_LEADS=20

# Compose uses the postgres service hostname. Change this for non-Compose deployments.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lead_crm_loader

# Local browser API; the production Vercel deployment uses same-origin rewrites instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Email is optional locally. Render Free blocks SMTP ports 25, 465, and 587;
# use a relay that supports STARTTLS on an allowed port such as 2525.
SMTP_HOST=
SMTP_PORT=2525
SMTP_FROM=Lead Research <noreply@localhost>
SMTP_USERNAME=
SMTP_PASSWORD=

# Needed only when enabling live research. Production demo keeps RESEARCH_ENABLED=false.
BROWSERBASE_API_KEY=
BROWSERBASE_SEARCH_MODE=fast
BROWSERBASE_MAX_CONCURRENCY=1
LLM_IN_MOCK_MODE=false
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Lead Research & CRM Loader
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Optional observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lead-research-crm-loader
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

TEST_MODE_BROWSERBASE_CALL_LIMIT=120
TEST_MODE_LLM_CALL_LIMIT=40
TEST_MODE_MAX_CANDIDATE_URLS=30
MAX_CANDIDATES=500
MAX_SEARCH_ROUNDS=10
MAX_CONCURRENCY=6
LLM_BATCH_SIZE=25
MAX_TARGETED_SEARCHES_PER_RUN=40
REQUEST_TIMEOUT_SECONDS=30
MIN_CONFIDENCE=0.70
