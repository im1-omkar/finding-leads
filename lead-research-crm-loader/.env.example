# Safe local demo: fake sources and a SQLite mock CRM, no external writes.
MOCK_MODE=false
SQLITE_PATH=./lead_crm_loader.sqlite3

# Optional LLM. If absent, the project uses a conservative deterministic fallback for local demos.
# For OpenAI: LLM_API_KEY=...
# For OpenRouter:
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Set MOCK_MODE=false only after you have configured both the search API and a dedicated HubSpot test account.
# MOCK_MODE=false
# TAVILY_API_KEY=...
# HUBSPOT_ACCESS_TOKEN=...
# HUBSPOT_API_VERSION=2026-09
# HUBSPOT_PORTAL_ID=...

MAX_CANDIDATES=250
MAX_SEARCH_ROUNDS=3
MAX_CONCURRENCY=6
REQUEST_TIMEOUT_SECONDS=12
MIN_CONFIDENCE=0.70
