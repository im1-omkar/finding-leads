# Set MOCK_MODE=true for synthetic normal runs, or false for live normal runs.
# Test mode uses live providers with these caps; normal live runs have no per-run provider-call cap.
MOCK_MODE=true
NUMBER_OF_LEADS=20
TEST_MODE_BROWSERBASE_CALL_LIMIT=120
TEST_MODE_LLM_CALL_LIMIT=40
TEST_MODE_MAX_CANDIDATE_URLS=30

# Account security and email delivery. In development, auth links are printed in backend logs.
APP_ENV=development
APP_SESSION_SECRET=development-only-change-me
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Lead Research <noreply@localhost>
SMTP_USERNAME=
SMTP_PASSWORD=

# Docker Compose overrides this with the internal PostgreSQL service URL.
# For a managed PostgreSQL instance, replace it with the provider's connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_crm_loader

# Required when MOCK_MODE=false. Search uses Browserbase; public pages are fetched directly first.
BROWSERBASE_API_KEY=
BROWSERBASE_SEARCH_MODE=fast
BROWSERBASE_MAX_CONCURRENCY=1

# Optional qualification model. OPENROUTER_API_KEY selects OpenRouter automatically.
# Mock runs use the deterministic classifier by default; opt in to model calls with this flag.
LLM_IN_MOCK_MODE=false
# OPENAI_API_KEY=...
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Lead Research & CRM Loader
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Optional observability. Leave tracing disabled unless you have a LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lead-research-crm-loader
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

MAX_CANDIDATES=500
MAX_SEARCH_ROUNDS=10
MAX_CONCURRENCY=6
LLM_BATCH_SIZE=25
MAX_TARGETED_SEARCHES_PER_RUN=40
REQUEST_TIMEOUT_SECONDS=30
MIN_CONFIDENCE=0.70
