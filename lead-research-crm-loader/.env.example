# Safe demo defaults. `memory://` is useful for offline local runs and tests.
MOCK_MODE=true
DATABASE_URL=memory://

# Optional LLM. OPENROUTER_API_KEY selects OpenRouter automatically.
# OPENAI_API_KEY=...
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Lead Research & CRM Loader
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Required only when MOCK_MODE=false.
# TAVILY_API_KEY=...

MAX_CANDIDATES=250
MAX_SEARCH_ROUNDS=3
MAX_CONCURRENCY=6
REQUEST_TIMEOUT_SECONDS=12
MIN_CONFIDENCE=0.70
